{
  "manifest_version": 3,
  "name": "Eq-Chrome-Extension",
  "version": "1.1",
  "description": "A 10-band audio equalizer for your active tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "eq-extension@thiagocolen",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "scripts": ["vendor/browser-polyfill.js", "background.js"]
  }
}
